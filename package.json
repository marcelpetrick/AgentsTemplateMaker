    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "5.1.2",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "prettier": "3.10.1",
